APP_NAME="ISP Auxiliar Beta"
APP_ENV=homologation
APP_DEBUG=false
APP_URL=https://beta.sistema.ievo.com.br
APP_PROVIDER_KEY=ievo_beta
APP_TIMEZONE=America/Sao_Paulo
APP_RELEASE_CHANNEL=beta
APP_RELEASE_ID=beta-AAAA-MM-DD-N
APP_RELEASE_COMMIT=HASH_COMPLETO_DA_RELEASE
APP_RELEASE_BUILD_DATE=AAAA-MM-DDTHH:MM:SSZ
APP_STABLE_BASE_URL=https://URL_STABLE_CONFIRMADA
APP_BETA_BASE_URL=https://beta.sistema.ievo.com.br

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isp_auxiliar_beta
DB_USERNAME=isp_auxiliar_beta
DB_PASSWORD=DEFINIR_EM_SECRET_STORE
DB_CHARSET=utf8mb4

SESSION_COOKIE_NAME=isp_auxiliar_beta_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_PATH=storage/sessions-beta
LOG_PATH=logs/beta/app.log
UPLOAD_PATH=storage/uploads-beta
TMP_PATH=tmp/beta

MKAUTH_BASE_URL=https://HOST_AUTORIZADO_DO_MKAUTH
MKAUTH_WRITE_ENABLED=false
MKAUTH_API_TOKEN=
MKAUTH_CLIENT_ID=
MKAUTH_CLIENT_SECRET=
MKAUTH_DB_HOST=HOST_SOMENTE_LEITURA_AUTORIZADO
MKAUTH_DB_PORT=3306
MKAUTH_DB_NAME=mkradius
MKAUTH_DB_USER=USUARIO_SOMENTE_LEITURA
MKAUTH_DB_PASSWORD=DEFINIR_EM_SECRET_STORE
MKAUTH_DB_CHARSET=utf8mb4
MKAUTH_DB_HASH_ALGOS=sha256,sha1

EVOTRIX_ENABLED=false
EVOTRIX_DRY_RUN=true
EVOTRIX_ALLOW_ONLY_TEST_PHONE=true
EMAIL_ENABLED=false
EMAIL_DRY_RUN=true
EMAIL_ALLOW_ONLY_TEST_EMAIL=true
MKAUTH_TICKET_ENABLED=false
MKAUTH_TICKET_DRY_RUN=true
CONTRACT_AUTO_CREATE_FINANCIAL_TICKET=false

MIGRATION_EVIDENCE_MAX_BYTES=8388608
MIGRATION_EVIDENCE_MAX_FILES=8
CONTRACT_FIDELIDADE_AUTOMATICA_MIGRACAO=true
CONTRACT_FIDELIDADE_AUTOMATICA_UPGRADE=false
CONTRACT_SUGERIR_RETENCAO_DOWNGRADE=true
