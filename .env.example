APP_NAME="ISP Auxiliar"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-servidor/isp_auxiliar/public
APP_PROVIDER_KEY=ievo
APP_TIMEZONE=America/Sao_Paulo
APP_RELEASE_CHANNEL=stable
APP_STABLE_BASE_URL=
APP_BETA_BASE_URL=
APP_RELEASE_ID=
APP_RELEASE_COMMIT=
CLIENT_DETAIL_TIMEOUT_SECONDS=10

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isp_auxiliar
DB_USERNAME=isp_auxiliar
DB_PASSWORD=troque_esta_senha
DB_CHARSET=utf8mb4

MKAUTH_BASE_URL=https://ip-ou-dominio-do-mkauth
MKAUTH_WRITE_ENABLED=false
MKAUTH_API_TOKEN=
MKAUTH_CLIENT_ID=Client_Id_informado_no_mkauth
MKAUTH_CLIENT_SECRET=Client_Secret_informado_no_mkauth
MKAUTH_DB_HOST=ip-ou-dominio-do-mysql-mkauth
MKAUTH_DB_PORT=3306
MKAUTH_DB_NAME=mkradius
MKAUTH_DB_USER=isp_auxiliar
MKAUTH_DB_PASSWORD=troque_esta_senha
MKAUTH_DB_CHARSET=utf8mb4
MKAUTH_DB_HASH_ALGOS=sha256,sha1

LOG_CHANNEL=file
LOG_LEVEL=info
LOG_PATH=logs/app.log

SESSION_COOKIE_NAME=isp_auxiliar_stable_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_PATH=storage/sessions
UPLOAD_PATH=storage/uploads
TMP_PATH=tmp
MIGRATION_EVIDENCE_MAX_BYTES=8388608
MIGRATION_EVIDENCE_MAX_FILES=8

CONTRACT_FIDELIDADE_AUTOMATICA_MIGRACAO=true
CONTRACT_FIDELIDADE_AUTOMATICA_UPGRADE=false
CONTRACT_SUGERIR_RETENCAO_DOWNGRADE=true
